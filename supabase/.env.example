# ============================================================================
# Variaveis de ambiente das Edge Functions do Mercado Pago.
#
# Aplicar como secrets no projeto Supabase (nao commitar valores reais):
#   supabase secrets set --env-file supabase/.env
#
# Ou pelo painel: Project Settings > Edge Functions > Secrets.
# ============================================================================

# Access token do app Mercado Pago (obrigatorio).
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_MERCADO_PAGO

# Segredo para validar o header x-signature do webhook (recomendado).
MP_WEBHOOK_SECRET=SEU_SEGREDO_DO_WEBHOOK

# "true" usa sandbox_init_point nas credenciais de teste.
MP_SANDBOX=true

# URL publica do app (usada como back_url apos o checkout).
APP_BASE_URL=https://wolfsistemas.github.io/rvportalpreparo

# Override opcional da API do Mercado Pago.
MP_API_BASE=https://api.mercadopago.com
